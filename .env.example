# Kian OS — environment variables (Vercel + Neon hosting)
# Copy to .env for local dev. In Vercel: Project Settings → Environment Variables.
# NEVER commit real values. This file contains placeholders only.

# PostgreSQL connection string. Used by the app at runtime and by
# `prisma migrate deploy` during `npm run vercel-build`.
# In Neon: use the pooled connection string, and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (non-pooled) connection string, used only by `prisma migrate deploy`.
# In Neon: the same string without "-pooler" in the host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: pg Pool size per serverless instance (default 5). Raise only if
# your database plan allows many concurrent connections.
# PG_POOL_MAX="5"

# Seed script credentials. Used ONLY by `npm run db:seed` (run once after the
# first deploy, or locally). Skipped safely if the user already exists.
SEED_USERNAME="kian"
SEED_PASSWORD="choose-a-strong-password-and-set-it-in-vercel"

# NOTE: no SESSION_SECRET is needed. Session tokens are cryptographically
# random 32-byte values; only their SHA-256 hash is stored in the database.
# The raw token lives solely in the httpOnly `kianos_session` cookie.

# ---------------------------------------------------------------------------
# Retired with the VM hosting: relay/ and ops/ remain in the repo for
# reference, but the Vercel deployment does not need them. If you ever run
# the old VM stack again, see ops/keepalive.sh and relay/client.mjs for the
# RELAY_URL / RELAY_SECRET / PG_* variables they expect.
# ---------------------------------------------------------------------------
